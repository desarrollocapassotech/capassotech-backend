# Copia de ejemplo para el programador externo.
# Guardar localmente como ".env" (ya está en .gitignore, no se commitea).
#
# DATABASE_URL apunta a la rama Neon "dev-programador": una copia AISLADA
# del proyecto "timetracker" (branch id br-holy-glitter-achiacbf), NO la base
# de producción. Los datos personales/financieros de esa rama van a ser
# reemplazados por datos ficticios antes de entregarla.
DATABASE_URL="postgresql://neondb_owner:npg_A6n7oMvWQEBi@ep-flat-pine-actip993-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Firebase: se mantiene igual que en producción (mismo proyecto de Auth),
# así que el programador inicia sesión con una cuenta real de Firebase.
# Necesita su propio firebase-service-account.json (no se versiona, pedírselo aparte).
FIREBASE_API_KEY=AIzaSyDlmYxqJ33RDBNmbDHjLWRP4ly2HkfZ4LY
FIREBASE_PROJECT_ID=capassotech-timetracker
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=capassotech-timetracker.firebasestorage.app

# Dejado en blanco a propósito: el script real de Google Sheets es el de
# PRODUCCIÓN. Con esta variable vacía, crear time entries en la rama
# dev-programador no dispara ninguna sincronización externa.
GOOGLE_SHEETS_TIME_ENTRIES_WEBHOOK_URL=
